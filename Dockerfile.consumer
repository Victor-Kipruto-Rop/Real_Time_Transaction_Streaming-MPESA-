FROM python:3.11-slim

WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

COPY Python/requirements/base.txt Python/requirements/data.txt Python/requirements/cloud.txt Python/requirements/ml.txt ./
RUN pip install --no-cache-dir --default-timeout=1000 -r base.txt && \
    pip install --no-cache-dir --default-timeout=1000 -r data.txt && \
    pip install --no-cache-dir --default-timeout=1000 -r cloud.txt && \
    pip install --no-cache-dir --default-timeout=1000 -r ml.txt

COPY Python/streaming ./streaming
COPY Python/schemas ./schemas

CMD ["python", "-m", "streaming.kafka_consumer"]
