# Example placeholders only; do not commit actual secrets.
MIX_ENV=dev
PORT=4000
PHX_HOST=localhost
SECRET_KEY_BASE=replace-with-a-random-secret-from-your-secret-manager
LOG_LEVEL=info

# Required for production customer webhook signing-secret encryption.
WEBHOOK_SECRET_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key-from-secret-manager

# Required by webhook-delivery only: base64-encoded 32-byte random AES-256 key.
WEBHOOK_SECRET_ENCRYPTION_KEY=REPLACE_WITH_BASE64_ENCODED_32_BYTE_RANDOM_KEY
