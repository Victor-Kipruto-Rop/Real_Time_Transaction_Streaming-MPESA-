# Example placeholders only; do not commit actual secrets.
MIX_ENV=dev
PORT=4000
PHX_HOST=localhost
SECRET_KEY_BASE=replace-with-a-random-secret-from-your-secret-manager
LOG_LEVEL=info

# Required only when the customer webhook dispatcher is enabled.
WEBHOOK_DELIVERY_WORKER_ENABLED=false
WEBHOOK_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key-from-secret-manager
