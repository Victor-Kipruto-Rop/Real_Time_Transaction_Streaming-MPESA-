# Copy values into your local shell or secret manager. Never commit real secrets.
# Event relay (use a dedicated database and its own outbox migration in development)
DATABASE_URL=postgres://pesaguard_dev:local-only-change-me@127.0.0.1:5432/pesaguard_dev?sslmode=disable
KAFKA_BROKERS=127.0.0.1:19092
INSTANCE_ID=local-event-relay
POLL_INTERVAL=2s
BATCH_SIZE=50
MAX_ATTEMPTS=12

# Quota engine (Redis URL format: redis://:password@host:port/db)
REDIS_URL=redis://:local-only-change-me@127.0.0.1:6379/0
INTERNAL_TOKEN=replace-with-a-random-secret-at-least-32-characters

# Infrastructure monitor. Keep internal URLs private; expose filtered status only.
CHECK_TARGETS=api=http://127.0.0.1:8000/healthz
